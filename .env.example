# KRIYA — contoh environment. Salin ke .env dan isi nilainya.
# JANGAN commit .env. Secret hanya hidup di sini dan di kredensial n8n.
# Referensi: KRIYA-MASTER.md Bagian 4.

# ===== web (Next.js) :3000 =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_URL=http://localhost:8000
NEXT_PUBLIC_CHAT_WEBHOOK_URL=http://localhost:5678/webhook/chat
NEXT_PUBLIC_USE_FIXTURES=true

# ===== api (Gin) :8080 =====
SUPABASE_DB_URL=
SUPABASE_JWT_SECRET=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
WEB_ORIGIN=http://localhost:3000
INTERNAL_API_KEY=

# ===== ai (FastAPI) :8000 =====
# SUPABASE_DB_URL, WEB_ORIGIN, INTERNAL_API_KEY dipakai bersama (lihat di atas)
GEMINI_API_KEY=

# ===== data scripts (AGENT-AI) =====
UNSPLASH_ACCESS_KEY=

# ===== LLM chatbot (OpenAI-compatible, dipakai oleh n8n) =====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== n8n :5678 =====
# Kredensial (LLM, Gemini, Postgres, INTERNAL_API_KEY, SMTP/Telegram) diisi via UI n8n.
