# KRIYA — contoh environment. Salin ke .env dan isi nilainya.
# JANGAN commit .env. Secret hanya hidup di sini dan di kredensial n8n.
# Referensi: KRIYA-MASTER.md Bagian 4.

# ===== web (Next.js) :3000 =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_CHAT_WEBHOOK_URL=http://localhost:5678/webhook/kriya-chat
NEXT_PUBLIC_USE_FIXTURES=true

# ===== api (Gin) :8080 =====
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
WEB_ORIGIN=http://localhost:3000
INTERNAL_API_KEY=

# ===== data scripts (AGENT-AI) =====
UNSPLASH_ACCESS_KEY=

# ===== LLM chatbot (OpenAI-compatible, dipakai oleh n8n) =====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== n8n :5678 =====
# Kredensial (LLM, Gemini, Postgres, INTERNAL_API_KEY, SMTP/Telegram) diisi via UI n8n.
# Kunci enkripsi kredensial n8n (wajib; buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# JANGAN diganti/hilang setelah kredensial tersimpan — data di automation/n8n/data jadi tak terbaca.
N8N_ENCRYPTION_KEY=

# ===== Supabase MCP (dipakai Claude Code, bukan runtime app) =====
# Dibaca oleh .mcp.json. Set sebagai env var di shell/sistem SEBELUM menjalankan `claude`.
# SUPABASE_ACCESS_TOKEN: Personal Access Token dari Supabase Dashboard
#   -> Account > Account Tokens > Generate new token
# SUPABASE_PROJECT_REF: ref project (bagian subdomain URL: https://<ref>.supabase.co)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
